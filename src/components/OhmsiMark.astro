<style>
  .ohmsi-mark {
    width: clamp(48px, 6vw, 64px);
    height: auto;
    display: block;
    flex-shrink: 0;
    overflow: visible;
  }

  .ohmsi-mark path {
    fill: var(--ink);
    stroke: var(--ink);
    stroke-width: 0.012;       /* hair-thin while drawing — pathLength=1 coords */
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;        /* total drawable length is 1 thanks to pathLength */
    stroke-dashoffset: 1;       /* start completely undrawn */
    fill-opacity: 0;            /* fill comes in once the stroke is complete */
    animation:
      ohmsi-draw 1.8s ease-out forwards,
      ohmsi-fill 0.5s ease-in   forwards;
  }

  /* Stagger each stroke so the omega draws first, then the dot, then the i —
     fill of each path triggers right as that path's outline completes. */
  .ohmsi-mark path:nth-of-type(1) {
    animation-delay: 0.2s, 2.0s;   /* omega: draws 0.2–2.0s, fills 2.0–2.5s */
  }
  .ohmsi-mark path:nth-of-type(2) {
    animation-duration: 0.6s, 0.4s;
    animation-delay: 2.0s, 2.6s;   /* dot:  draws 2.0–2.6s, fills 2.6–3.0s */
  }
  .ohmsi-mark path:nth-of-type(3) {
    animation-duration: 1.0s, 0.4s;
    animation-delay: 2.4s, 3.4s;   /* i:    draws 2.4–3.4s, fills 3.4–3.8s */
  }

  @keyframes ohmsi-draw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes ohmsi-fill {
    to { fill-opacity: 1; }
  }

  /* Respect users who prefer reduced motion — show the final state instantly. */
  @media (prefers-reduced-motion: reduce) {
    .ohmsi-mark path {
      animation: none;
      stroke-dashoffset: 0;
      fill-opacity: 1;
    }
  }
</style>
