---
import Base from '../layouts/Base.astro';

// Wildlife photo studies. The original site has 16 image slots — those
// originals weren't reachable to scrape, so this page renders the
// description and reserves a grid the owner can populate via Decap CMS
// or by dropping files into /public/images/havelock/.
const photos: Array<{ file: string; alt: string }> = [
  // Owner: drop photos here, e.g. { file: 'kingfisher.jpg', alt: 'Kingfisher at the bridge' }
];
---
<Base
  title="Havelock's Haven"
  description="Photo studies of local wildlife — the residents and visitors to People's Park, Havelock. Prints can be purchased from the cafe."
>
  <section class="hero">
    <div class="container">
      <h1>Havelock's Haven</h1>
      <p class="hero__byline">a wildlife sketchbook</p>
    </div>
  </section>

  <section class="section--narrow">
    <p class="lede">
      Photo studies of our local wildlife — mainly the residents and visitors
      to People's Park.
    </p>
    <p>
      Prints can be purchased from the cafe.
    </p>
  </section>

  {photos.length > 0 ? (
    <div class="container">
      <div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));">
        {photos.map(p => (
          <figure class="card" style="margin: 0; padding: 0; overflow: hidden;">
            <img
              src={`/images/havelock/${p.file}`}
              alt={p.alt}
              loading="lazy"
              style="aspect-ratio: 4/3; object-fit: cover; width: 100%;"
            />
            <figcaption class="mono" style="padding: 0.5rem 0.75rem; font-size: 0.85rem; color: var(--ink-soft);">
              {p.alt}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  ) : (
    <div class="container" style="margin: 2rem auto 4rem;">
      <p class="text-center mono" style="color: var(--ink-soft); padding: 2rem; border: 1px dashed var(--rule);">
        Gallery refresh in progress — new images coming soon.
      </p>
    </div>
  )}
</Base>
